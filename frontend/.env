# VastGrid Client Configuration Environment Variables
# Prefixed with VITE_ to be exposed to Vite client-side bundle

# The backend service API endpoint for local telemetry routing
VITE_API_BASE_URL=http://localhost:5000/api

# Keycloak identity server configuration settings
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=vastgrid-realm
VITE_KEYCLOAK_CLIENT_ID=vastgrid-spa-client

# Operational settings
VITE_ENABLE_MOCK_TELEMETRY=true
VITE_LOG_LEVEL=DEBUG
VITE_ENABLE_KEYCLOAK=true
